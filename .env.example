APP_NAME=Resora API
API_VERSION=0.1.0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional live provider keys
GROQ_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Local development storage
DATABASE_URL=sqlite:///./resora.db
REDIS_URL=redis://localhost:6379/0

# Optional web search. Providers with missing keys are skipped automatically.
TAVILY_API_KEY=
EXA_API_KEY=
WEB_SEARCH_PROVIDER_ORDER=tavily,exa
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=86400
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MONTHLY_BUDGETS={"tavily":1000,"exa":1000}

# Local key-free engines run first; keyed providers are skipped when not configured.
TRANSLATION_PROVIDER_ORDER=translator_local,azure,google_cloud,deepl,groq
TRANSLATION_LANGUAGE_ROUTES={}
TRANSLATION_TIMEOUT_SECONDS=8
TRANSLATION_CACHE_PATH=storage/translation_cache.sqlite3
TRANSLATION_MONTHLY_CHARACTER_BUDGETS={}
TRANSLATION_DAILY_CHARACTER_BUDGETS={}
TRANSLATION_USER_DAILY_CHARACTER_LIMIT=100000
# Azure AI Translator (official)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Google Cloud Translation v3 uses Application Default Credentials/service account, not a scraped endpoint
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_MODEL=general/nmt
GOOGLE_TRANSLATE_GLOSSARY_NAME=
# DeepL API Free/Pro (supported languages only)
DEEPL_API_KEY=
# Self-hosted Apache-2.0 MADLAD-400 service; start with docker-compose.translation.yml
SELFHOSTED_TRANSLATOR_URL=
LOCAL_TRANSLATOR_URL=http://translator-local:8091
LOCAL_TRANSLATION_LANGUAGES=en,ur,ar,fa,hi,bn,pa-Arab,tr,id,ms,zh-Hans,zh-Hant,ja,ko,vi,th,es,pt-BR,pt-PT,fr,de,it,nl,pl,ru,uk,sv,el,ro,cs,hu,he,sw,ta,ps,sd
LOCAL_TRANSLATION_THREADS=1
LOCAL_TRANSLATION_MAX_LOADED_MODELS=1
LOCAL_TRANSLATION_ENGINE_ORDER=argos,m2m100,opus_mt
LOCAL_TRANSLATION_LANGUAGE_ROUTES={}
TRANSLATION_DISABLE_ENGINES=
LOCAL_TRANSLATION_MEMORY_LIMIT=1536m
LOCAL_TRANSLATION_CPUS=1.0
ARGOS_MAX_DOWNLOAD_MB=4096
MADLAD_MODEL_ID=google/madlad400-3b-mt
MADLAD_DEVICE=cpu
# Groq fallback uses the existing GROQ_API_KEY and TRANSLATION_MODEL
TRANSLATION_MODEL=openai/gpt-oss-20b

TRANSLATION_ADMIN_USER_IDS=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
AI_ROUTER_ROUTES_PATH=apps/api/app/services/ai_router/routes.json
AI_ROUTER_CACHE_TTL_SECONDS=86400
AI_ROUTER_FREE_MODELS_ONLY=true
AI_ROUTER_MAX_CONCURRENCY=4
AI_ROUTER_PROVIDER_LIMITS={"openrouter":{"rpd":50}}
AI_ROUTER_HEALTH_PROBE_SECONDS=300
AI_ROUTER_MODEL_GEMINI=gemini-3.8-flash
AI_ROUTER_MODEL_GROQ=openai/gpt-oss-20b
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
HF_TOKEN=
SILICONFLOW_API_KEY=
MODELSCOPE_TOKEN=
# Required by Unpaywall/OpenAlex for open-access PDF lookup. Must be a real address; example.com or .local values disable the lookup.
UNPAYWALL_EMAIL=your-real-email@example.org
OPENALEX_MAILTO=your-real-email@example.org
# ---- Resora batch B: append these lines to .env.example (placeholders only — never put real keys here) ----
# Billing and Teams tables live in the existing DATABASE_URL (SQLite in dev, PostgreSQL in production).

# Subscriptions and credit packs. "sandbox" needs no external account (signed fake checkout + webhook).
BILLING_PROVIDER=sandbox                # sandbox | stripe | paddle | lemonsqueezy
BILLING_WEBHOOK_SECRET=change-me-long-random-string
STRIPE_SECRET_KEY=
PADDLE_API_KEY=
PADDLE_ENV=sandbox                      # sandbox | production
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# JSON map plan:interval:currency → provider price id, e.g. {"pro:month:usd":"price_xxx"}
BILLING_PROVIDER_PRICES={}
# Optional JSON overrides of the built-in plan / credit-pack catalog (prices in minor units)
BILLING_PRICES=
BILLING_PACKS=

# Research catalog (Big Data pipeline output read by the API)
CATALOG_DATABASE_URL=                   # empty = SQLite apps/api/storage/catalog.sqlite3; or postgresql://user:pass@host/db
PIPELINE_OUTPUT_DIR=                    # empty = apps/api/storage/pipeline
CATALOG_ADMIN_USER_IDS=                 # comma-separated user ids allowed to start pipeline runs

# Pipeline (apps/pipeline)
LAKE_URI=                               # empty = ./data/lake ; or s3://resora-lake
OBJECT_STORE_URI=                       # empty = ./data/objects ; or s3://resora-objects
S3_ENDPOINT_URL=                        # e.g. http://localhost:9000 for MinIO
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
CONTACT_EMAIL=research@example.org      # sent as OpenAlex/Crossref "mailto" (polite pool) — set the real one only in .env
SEMANTIC_SCHOLAR_API_KEY=
KAFKA_BOOTSTRAP_SERVERS=                # empty = events go to the lake event log only
EMBEDDER=hash-v1                        # hash-v1 (no download) | sentence-transformers model name
# ---- Resora batch C: append these lines to .env.example (placeholders only — never put real keys here) ----

# Admin console (/admin): comma-separated account ids. Production requires a verified (signed) sign-in.
ADMIN_USER_IDS=

# Listen — self-hosted natural voices (optional). Empty = device voices only (free, private).
TTS_KOKORO_URL=                         # e.g. http://localhost:8880 (infra/docker-compose.tts.yml)
TTS_CACHE_DIR=                          # empty = apps/api/storage/tts-cache
LISTEN_NEURAL_CREDITS_PER_MINUTE=1
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest   # pin to a release tag in production

# Growth
REFERRAL_CREDITS=50
REFERRAL_MAX_REWARDS=20

# Newsletter confirmation e-mails (double opt-in). Empty SMTP_HOST = no e-mails are sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Resora <no-reply@example.com>
SMTP_STARTTLS=1
PUBLIC_SITE_URL=http://localhost:5173

# Web (Vite): public domain used for canonical / hreflang / Open Graph URLs
VITE_PUBLIC_SITE_URL=

# Paper studio (LaTeX)
STUDIO_STORAGE_DIR=                     # empty = apps/api/storage/studio
STUDIO_COMPILE_TIMEOUT=45
STUDIO_MAX_PARALLEL=2
