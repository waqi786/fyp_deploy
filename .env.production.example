APP_NAME=Resora API
API_VERSION=0.1.0
CORS_ALLOWED_ORIGINS=https://your-domain.example

DATABASE_URL=postgresql://user:password@postgres:5432/resora
REDIS_URL=redis://redis:6379/0

# Optional web search. Providers with missing keys are skipped automatically.
TAVILY_API_KEY=
EXA_API_KEY=
WEB_SEARCH_PROVIDER_ORDER=tavily,exa
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_TTL_SECONDS=86400
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_MONTHLY_BUDGETS={"tavily":1000,"exa":1000}

GROQ_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me
SENTRY_DSN=

# Local key-free engines run first; keyed providers are skipped when not configured.
TRANSLATION_PROVIDER_ORDER=translator_local,azure,google_cloud,deepl,groq
TRANSLATION_LANGUAGE_ROUTES={}
TRANSLATION_TIMEOUT_SECONDS=8
TRANSLATION_CACHE_PATH=storage/translation_cache.sqlite3
TRANSLATION_MONTHLY_CHARACTER_BUDGETS={}
TRANSLATION_DAILY_CHARACTER_BUDGETS={}
TRANSLATION_USER_DAILY_CHARACTER_LIMIT=100000
# Azure AI Translator (official)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Google Cloud Translation v3 uses Application Default Credentials/service account, not a scraped endpoint
GOOGLE_TRANSLATE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_MODEL=general/nmt
GOOGLE_TRANSLATE_GLOSSARY_NAME=
# DeepL API Free/Pro (supported languages only)
DEEPL_API_KEY=
# Self-hosted Apache-2.0 MADLAD-400 service; start with docker-compose.translation.yml
SELFHOSTED_TRANSLATOR_URL=
LOCAL_TRANSLATOR_URL=http://translator-local:8091
LOCAL_TRANSLATION_LANGUAGES=en,ur,ar,fa,hi,bn,pa-Arab,tr,id,ms,zh-Hans,zh-Hant,ja,ko,vi,th,es,pt-BR,pt-PT,fr,de,it,nl,pl,ru,uk,sv,el,ro,cs,hu,he,sw,ta,ps,sd
LOCAL_TRANSLATION_THREADS=1
LOCAL_TRANSLATION_MAX_LOADED_MODELS=1
LOCAL_TRANSLATION_ENGINE_ORDER=argos,m2m100,opus_mt
LOCAL_TRANSLATION_LANGUAGE_ROUTES={}
TRANSLATION_DISABLE_ENGINES=
LOCAL_TRANSLATION_MEMORY_LIMIT=1536m
LOCAL_TRANSLATION_CPUS=1.0
ARGOS_MAX_DOWNLOAD_MB=4096
MADLAD_MODEL_ID=google/madlad400-3b-mt
MADLAD_DEVICE=cpu
# Groq fallback uses the existing GROQ_API_KEY and TRANSLATION_MODEL
TRANSLATION_MODEL=openai/gpt-oss-20b

TRANSLATION_ADMIN_USER_IDS=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
AI_ROUTER_ROUTES_PATH=apps/api/app/services/ai_router/routes.json
AI_ROUTER_CACHE_TTL_SECONDS=86400
AI_ROUTER_FREE_MODELS_ONLY=true
AI_ROUTER_MAX_CONCURRENCY=4
AI_ROUTER_PROVIDER_LIMITS={"openrouter":{"rpd":50}}
AI_ROUTER_HEALTH_PROBE_SECONDS=300
AI_ROUTER_MODEL_GEMINI=gemini-3.8-flash
AI_ROUTER_MODEL_GROQ=openai/gpt-oss-20b
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
HF_TOKEN=
SILICONFLOW_API_KEY=
MODELSCOPE_TOKEN=
# Required by Unpaywall/OpenAlex for open-access PDF lookup. Must be a real address; example.com or .local values disable the lookup.
UNPAYWALL_EMAIL=your-real-email@example.org
OPENALEX_MAILTO=your-real-email@example.org
