{
  "manifest_version": 3,
  "name": "Send to Resora",
  "version": "0.1.0",
  "description": "Send the current paper or webpage to the local Resora workspace.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_title": "Send to Resora",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}

